# Settings the Keystatic editor needs. Copy this file to `.env` and fill in the
# values — `.env` is gitignored and must never be committed.
#
# WHERE THE VALUES COME FROM
# Run `npm run dev`, open http://localhost:4321/keystatic and follow the setup
# wizard. It creates a GitHub App for you and shows you these four values.
# You do not have to create the app by hand.
#
# WHICH OF THESE ARE SECRET
# The first three are. Never commit them, never paste them into a chat or an
# issue. The fourth is deliberately public — Astro bakes any PUBLIC_* value
# into the browser bundle, and this one is just your app's public name.
#
# THIS FILE IS FOR LOCAL DEVELOPMENT ONLY.
# Production reads the same values from Cloudflare, not from here:
#   npx wrangler secret put KEYSTATIC_GITHUB_CLIENT_ID
#   npx wrangler secret put KEYSTATIC_GITHUB_CLIENT_SECRET
#   npx wrangler secret put KEYSTATIC_SECRET
# and PUBLIC_KEYSTATIC_GITHUB_APP_SLUG is set as a *build* variable, because it
# is read while the site is being built rather than while it is running.

# Identifies the GitHub App. From the setup wizard.
KEYSTATIC_GITHUB_CLIENT_ID=

# Proves this site really is that app when exchanging a login code for a
# token. From the setup wizard. Treat like a password.
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Not from GitHub — you generate this one. It encrypts the GitHub token stored
# in your browser cookie. Any long random string:
#   openssl rand -hex 32
KEYSTATIC_SECRET=

# Your GitHub App's slug (the name in its URL). Not secret.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
