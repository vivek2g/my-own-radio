---
// The base HTML shell every page uses: <head>, header, slot, footer.
// Pass `title` and `description` props per page for SEO and the browser tab.
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // Which section the page belongs to, for the rail's active state. Pages that
  // live at a rail URL can leave this unset — the rail matches on the URL.
  activeSection?: string;
}

const {
  title,
  description = 'A personal journal of treks, travel, and philosophical & spiritual reflection.',
  activeSection,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Fonts: Newsreader (reading serif) + Inter (UI sans). Preconnect first so
         they start downloading early; display=swap shows text immediately using
         a fallback, then swaps when the web font arrives (no invisible text). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <!-- Apply saved preferences before paint, so there's no flash of the wrong
         colors or of a section rail that's about to collapse. This has to run
         here rather than in a component: every link is a full page load, so
         without it each navigation would briefly show the default state. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
          if (localStorage.getItem('rail') === 'collapsed') {
            document.documentElement.setAttribute('data-rail', 'collapsed');
          }
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <!-- Open Graph: how the page looks when shared on social/chat apps -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
  </head>
  <body>
    <Header />
    <!-- Two-column shell: the section rail, then the page content. Below the
         sidebar breakpoint the grid collapses to one column and the rail
         becomes a horizontal strip above the content. -->
    <div class="shell">
      <Sidebar activeSection={activeSection} />
      <main class="shell__main">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>

<style>
  .shell {
    display: grid;
    grid-template-areas: 'rail' 'main';
  }
  .shell__main {
    grid-area: main;
    min-width: 0;
  }

  /* Collapsing animates the grid track the rail occupies rather than toggling
     `display`, which cannot be transitioned. The rail clips its own overflow
     (see Sidebar.astro) so its contents slide away as the track shrinks. */

  /* Phones: the rail is a row above the content, so the row collapses.
     `1fr -> 0fr` is the trick for animating to and from an unknown height.
     PRECONDITION: this only sizes the rail row to its content because .shell's
     height is indefinite. If anything ever gives it a definite height (a
     `body { min-height: 100vh }` sticky-footer, say), `1fr` would start
     claiming leftover space and the rail row would balloon. */
  @media (max-width: 899px) {
    .shell {
      grid-template-rows: 1fr auto;
      transition: grid-template-rows var(--rail-collapse) ease;
    }
    :root[data-rail='collapsed'] .shell {
      grid-template-rows: 0fr auto;
    }
  }

  /* Desktop: the rail is a column, so the column width animates to zero and
     the article widens into the space. */
  @media (min-width: 900px) {
    .shell {
      grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
      grid-template-areas: 'rail main';
      align-items: start;
      /* No gap: it would survive the collapse as a stray offset. The rail's
         own nav carries the full spacing instead, and gets clipped with it. */
      gap: 0;
      padding-inline: clamp(1.1rem, 4vw, 2.75rem);
      padding-top: 1.75rem;
      transition: grid-template-columns var(--rail-collapse) ease;
    }
    :root[data-rail='collapsed'] .shell {
      grid-template-columns: 0 minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shell {
      transition: none;
    }
  }
</style>
