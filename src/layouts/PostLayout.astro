---
// Layout for a single blog post. Receives the post's typed frontmatter and
// renders the article body into the <slot />.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
---

<BaseLayout title={title} description={description}>
  <div class="container">
  <article>
    <header class="post-header">
      <p class="kicker meta">
        <FormattedDate date={pubDate} />
        {updatedDate && <span> &middot; updated <FormattedDate date={updatedDate} /></span>}
      </p>
      <h1>{title}</h1>
      {description && <p class="dek">{description}</p>}
      {tags.length > 0 && (
        <ul class="tags font-ui">
          {tags.map((tag) => <li>#{tag}</li>)}
        </ul>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  <p class="font-ui"><a href="/blog">&larr; Back to the journal</a></p>
  </div>
</BaseLayout>

<style>
  .post-header {
    margin-block: 3.5rem 2.25rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }
  .post-header h1 {
    margin: 0.5rem 0 0;
    font-size: var(--step-3);
  }
  .meta {
    margin: 0;
  }
  .dek {
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--color-muted);
    margin: 0.9rem 0 0;
    font-style: italic;
  }
  .tags {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tags li {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
  }

  /* Reading body rhythm */
  .prose :global(p) {
    margin: 0 0 1.4rem;
  }
  .prose :global(h2) {
    font-size: var(--step-2);
    margin: 2.5rem 0 0.75rem;
  }
  .prose :global(h3) {
    font-size: var(--step-1);
    margin: 2rem 0 0.5rem;
  }
  /* In-prose links underlined for readability within running text */
  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* A classic drop cap on the first paragraph */
  .prose :global(p:first-of-type::first-letter) {
    float: left;
    font-size: 3.1em;
    line-height: 0.82;
    padding: 0.05em 0.12em 0 0;
    font-weight: 500;
    color: var(--color-text);
  }
  .prose :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    margin: 2rem 0;
    padding-left: 1.25rem;
    color: var(--color-muted);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
