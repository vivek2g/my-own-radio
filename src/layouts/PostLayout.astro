---
// Layout for a single blog post. Receives the post's typed frontmatter and
// renders the article body into the <slot />.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { categoryLabel } from '../lib/categories';
import { slugifyTag, tagLabel } from '../lib/tags';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, category, pubDate, updatedDate, tags, heroImage, heroAlt } =
  post.data;
---

<BaseLayout title={title} description={description} activeSection={category}>
  <div class="container">
  <article>
    <header class="post-header">
      <p class="kicker meta">
        <a class="meta__cat" href={`/${category}/`}>{categoryLabel(category)}</a>
        <span aria-hidden="true"> &middot; </span>
        <FormattedDate date={pubDate} />
        {updatedDate && <span> &middot; updated <FormattedDate date={updatedDate} /></span>}
      </p>
      <h1>{title}</h1>
      {description && <p class="dek">{description}</p>}
      {tags.length > 0 && (
        <ul class="tags font-ui">
          {tags.map((tag) => (
            <li><a href={`/tags/${slugifyTag(tag)}/`}>#{tagLabel(tag)}</a></li>
          ))}
        </ul>
      )}
    </header>
    <img class="post-hero cut-corner" src={heroImage ?? '/images/post-default.svg'} alt={heroAlt ?? ''} />
    <div class="prose">
      <slot />
    </div>
  </article>
  <p class="font-ui"><a href={`/${category}/`}>&larr; Back to {categoryLabel(category)}</a></p>
  </div>
</BaseLayout>

<style>
  .post-header {
    margin-block: 3.5rem 2.25rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }
  .post-header h1 {
    margin: 0.5rem 0 0;
    font-size: clamp(2.2rem, 1.5rem + 3vw, 3.6rem);
    font-weight: 700;
  }
  .meta {
    margin: 0;
  }
  .meta__cat {
    color: var(--color-accent);
    font-weight: 500;
  }
  .dek {
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--color-muted);
    margin: 0.9rem 0 0;
    font-style: italic;
  }
  .tags {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tags a {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .tags a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    text-decoration: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .tags a {
      transition: none;
    }
  }

  .post-hero {
    display: block;
    width: 100%;
    /* No fixed ratio: the post page shows the photo as it actually is, so a
       tall or square shot isn't cropped to a letterbox. Capped so a very tall
       image can't push the article off the screen. */
    height: auto;
    max-height: 80vh;
    object-fit: contain;
    border-radius: var(--radius);
    margin: 0 0 2rem;
  }

  /* Reading body rhythm */
  .prose :global(p) {
    margin: 0 0 1.4rem;
  }
  /* In-article subheads stay in the reading serif; only the post title uses
     the display grotesque. */
  .prose :global(h2) {
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: -0.01em;
    font-size: var(--step-2);
    margin: 2.5rem 0 0.75rem;
  }
  .prose :global(h3) {
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: -0.01em;
    font-size: var(--step-1);
    margin: 2rem 0 0.5rem;
  }
  /* In-prose links underlined for readability within running text */
  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* A classic drop cap on the first paragraph */
  .prose :global(p:first-of-type::first-letter) {
    float: left;
    font-size: 3.1em;
    line-height: 0.82;
    padding: 0.05em 0.12em 0 0;
    font-weight: 500;
    color: var(--color-text);
  }
  .prose :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    margin: 2rem 0;
    padding-left: 1.25rem;
    color: var(--color-muted);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
