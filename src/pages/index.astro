---
// Home page: the newest post leads with a large headline and image, then the
// rest follow in the standard list (see docs/DECISIONS.md #16 for why the lead
// keeps its headline-then-image shape rather than text over the photo).
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts } from '../lib/posts';
import { categoryLabel } from '../lib/categories';

const posts = await getPublishedPosts();

const [lead, ...rest] = posts;
const restToShow = rest.slice(0, 6);

// Shown when a post has no heroImage of its own.
const DEFAULT_IMAGE = '/images/post-default.svg';
---

<BaseLayout title="My Own Radio">
  <div class="container">
    {posts.length === 0 ? (
      <p class="page__empty">No posts yet. The first one is on its way.</p>
    ) : (
      <>
        <a class="lead" href={`/blog/${lead.id}/`}>
          <p class="kicker lead__meta">
            <span class="lead__cat">{categoryLabel(lead.data.category)}</span>
            <span aria-hidden="true"> &middot; </span>
            <FormattedDate date={lead.data.pubDate} />
          </p>
          <h1 class="lead__title">{lead.data.title}</h1>
          <img
            class="lead__img cut-corner"
            src={lead.data.heroImage ?? DEFAULT_IMAGE}
            alt={lead.data.heroAlt ?? ''}
          />
          <p class="lead__excerpt">{lead.data.description}</p>
        </a>

        {restToShow.length > 0 && (
          <section class="more">
            <h2 class="kicker more__label">More from the journal</h2>
            <PostList posts={restToShow} />
          </section>
        )}

        {posts.length > restToShow.length + 1 && (
          <p class="more__link font-ui"><a href="/blog/">See all posts &rarr;</a></p>
        )}
      </>
    )}
  </div>
</BaseLayout>

<style>
  .page__empty {
    color: var(--color-muted);
  }

  /* Lead story: kicker, big headline, then the image. */
  .lead {
    display: block;
    color: inherit;
    margin-top: 1rem;
  }
  .lead:hover {
    text-decoration: none;
  }
  .lead__meta {
    margin: 0 0 0.5rem;
  }
  .lead__cat {
    color: var(--color-accent);
    font-weight: 500;
  }
  .lead__title {
    font-size: clamp(2.2rem, 1.5rem + 3vw, 3.6rem);
    font-weight: 700;
    margin: 0 0 1.4rem;
    max-width: 16ch;
  }
  .lead:hover .lead__title {
    color: var(--color-accent);
  }
  .lead__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 1.2rem;
  }
  .lead__excerpt {
    font-size: var(--step-1);
    color: var(--color-muted);
    margin: 0;
    max-width: 40ch;
  }

  .more {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .more__label {
    margin: 0;
  }
  .more__link {
    margin-top: 1.75rem;
  }
</style>
