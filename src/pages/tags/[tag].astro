---
// One page per tag, e.g. /tags/trek/. Mirrors [category].astro's pattern:
// getStaticPaths derives every route at build time from actual post data,
// so there's no route for a tag that doesn't exist.
import type { GetStaticPaths } from 'astro';
import ListingLayout from '../../layouts/ListingLayout.astro';
import { getAllTags } from '../../lib/tags';
import { getPublishedPosts } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const tags = getAllTags(posts);

  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }));
}) satisfies GetStaticPaths;

const { tag } = Astro.props;
---

<ListingLayout
  heading={`#${tag.label}`}
  blurb={`Posts tagged "${tag.label}".`}
  posts={tag.posts}
/>
