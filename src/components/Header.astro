---
// Slim top bar: brand on the left, tools on the right. Section navigation
// lives in the left rail (src/components/Sidebar.astro), not here.
import Search from './Search.astro';
---

<header class="site-header font-ui">
  <div class="bar">
    <div class="bar__left">
      <!-- Hidden until the script runs, so a visitor without JavaScript never
           sees a control that can't work — they keep a permanently open rail. -->
      <button
        id="rail-toggle"
        class="icon-btn"
        type="button"
        aria-controls="section-rail"
        aria-expanded="true"
        aria-label="Hide sections"
        hidden
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <a href="/" class="brand"><span class="brand__dot" aria-hidden="true"></span>My Own Radio</a>
    </div>
    <nav aria-label="Site tools">
      <Search />
      <button id="theme-toggle" class="icon-btn" type="button" aria-label="Toggle theme"></button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  /* Full-width bar: brand at the far left, nav at the far right, like Medium.
     Padding (not a narrow max-width) keeps content off the screen edges; the
     bar itself spans the whole page even though articles stay in a narrow
     reading column. */
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-height);
    padding-block: 0.6rem;
    padding-inline: clamp(1.1rem, 4vw, 2.75rem);
  }
  /* Hamburger + brand travel together at the far left. */
  .bar__left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  /* Load-bearing, despite looking redundant: `.icon-btn` sets `display:
     inline-flex`, and an author rule beats the browser's own `[hidden] {
     display: none }`. Without this the button would stay visible while the
     `hidden` attribute is set — i.e. for everyone without JavaScript.
     Search.astro carries the same guard for the same reason. */
  #rail-toggle[hidden] {
    display: none;
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .brand__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-accent);
    flex: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');

  const sun = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>';
  const moon = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>';

  const current = () =>
    root.getAttribute('data-theme') ||
    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

  const render = () => {
    if (!btn) return;
    const t = current();
    // Show the icon for the theme the click will switch TO.
    btn.innerHTML = t === 'dark' ? sun : moon;
    btn.setAttribute('aria-label', t === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
  };

  btn?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {}
    render();
  });

  // If the device theme changes and the visitor hasn't overridden it, follow along.
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => {
      if (!root.getAttribute('data-theme')) render();
    });

  render();

  // Section rail toggle. The state lives in a data attribute on <html> (the CSS
  // in Sidebar/BaseLayout keys off it) and in localStorage, which BaseLayout's
  // inline script re-applies before paint on the next page — without that, the
  // rail would reopen on every navigation.
  const railBtn = document.getElementById('rail-toggle');

  if (railBtn) {
    const railCollapsed = () => root.getAttribute('data-rail') === 'collapsed';

    const renderRailBtn = () => {
      const collapsed = railCollapsed();
      railBtn.setAttribute('aria-expanded', String(!collapsed));
      railBtn.setAttribute('aria-label', collapsed ? 'Show sections' : 'Hide sections');
    };

    railBtn.addEventListener('click', () => {
      const next = railCollapsed() ? 'shown' : 'collapsed';
      if (next === 'collapsed') {
        root.setAttribute('data-rail', 'collapsed');
      } else {
        root.removeAttribute('data-rail');
      }
      try {
        localStorage.setItem('rail', next);
      } catch (e) {}
      renderRailBtn();
    });

    // Only reveal the control once we know the script is running.
    railBtn.hidden = false;
    renderRailBtn();
  }
</script>
