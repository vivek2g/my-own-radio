---
// The left section rail: Home plus one link per category.
// Sections come from src/lib/categories.ts, so this list never drifts from the
// post schema or the category pages.
//
// Below --sidebar-breakpoint the rail becomes a horizontal, scrollable strip
// that sits above the content — the same links, just laid out in a row.
// The header's hamburger can hide it entirely at any width.
import { CATEGORIES } from '../lib/categories';

interface Props {
  // Pages that aren't at a rail URL can name the section they belong to — a
  // post at /blog/<slug>/ passes its own category so the rail highlights that
  // section rather than "All posts".
  activeSection?: string;
}

const { activeSection } = Astro.props;

// Primary: the reading sections. Secondary: the full archive and the about
// page, kept reachable but visually subordinate.
const links = [
  { href: '/', label: 'Home' },
  ...CATEGORIES.map((c) => ({ href: `/${c.slug}/`, label: c.label })),
];

const secondaryLinks = [
  { href: '/blog/', label: 'All posts' },
  { href: '/about/', label: 'About' },
];

// Mark the current section. An explicit activeSection wins; otherwise match on
// the URL, where "/" must match exactly so a category page doesn't also light
// up Home.
const path = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (activeSection) return href === `/${activeSection}/`;
  return href === '/' ? path === '/' : path.startsWith(href);
};
---

<aside id="section-rail" class="rail font-ui">
  <nav aria-label="Sections">
    <ul>
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['rail__link', { 'is-current': isCurrent(link.href) }]}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
      {secondaryLinks.map((link) => (
        <li class="rail__secondary">
          <a
            href={link.href}
            class:list={['rail__link', { 'is-current': isCurrent(link.href) }]}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<style>
  .rail {
    grid-area: rail;
    /* The grid track animates to zero when collapsed (see BaseLayout); these
       let this box shrink with it and clip its contents rather than spilling. */
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.18s ease;
  }
  /* Collapsed by the header's hamburger. The attribute is set on <html> before
     paint (see BaseLayout) so it survives navigation without flashing.
     `visibility` is delayed until the track has finished shrinking, so the
     links leave the tab order only once they're actually gone. */
  :root[data-rail='collapsed'] .rail {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s ease, visibility 0s linear var(--rail-collapse);
  }
  .rail ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rail__link {
    display: block;
    padding: 0.5rem 0.7rem;
    border-radius: 6px;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.3;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .rail__link:hover {
    color: var(--color-text);
    background: var(--color-surface);
    text-decoration: none;
  }
  .rail__link.is-current {
    color: var(--color-text);
    font-weight: 500;
    background: var(--color-surface);
  }

  /* Desktop: a sticky column that stays put while the article scrolls. */
  @media (min-width: 900px) {
    .rail {
      position: sticky;
      top: calc(var(--header-height) + 1.75rem);
      align-self: start;
    }
    /* The whole gap to the article lives here, inside the clipped box, so it
       disappears with the rail instead of leaving a sliver behind. This
       replaces both the old grid `gap` (1.5rem) and the old `.rail`
       padding-right (1rem) — hence 2.5rem, not 1.5rem. */
    .rail nav {
      padding-right: 2.5rem;
    }
    .rail li + li {
      margin-top: 0.15rem;
    }
    /* A hairline separates the reading sections from the utility links. */
    .rail__secondary:first-of-type {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--color-border);
    }
  }

  /* Phones and tablets: one scrollable row of section links. */
  @media (max-width: 899px) {
    /* Rule and spacing sit on the inner element so the clipped .rail box takes
       them with it when collapsed — otherwise a stray line would remain. */
    .rail nav {
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 1.5rem;
    }
    .rail ul {
      display: flex;
      gap: 0.3rem;
      overflow-x: auto;
      padding: 0.6rem 1.4rem;
      /* Hide the scrollbar but keep the scrolling. */
      scrollbar-width: none;
    }
    .rail ul::-webkit-scrollbar {
      display: none;
    }
    .rail__link {
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail,
    .rail__link {
      transition: none;
    }
  }
</style>
